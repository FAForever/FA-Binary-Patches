# Moho::AudioEngine::AudioEngine
# Replace the call to func_AudioInitialize with a version that also sizes the
# 3D DSP buffers from XACT's final mix channel mask
0x004D9588:
    mov     eax, [esi]
    push    eax
    call    @X3DAudioInitializeSized
    add     esp, 4
    jmp     0x004D959C
    nop
    nop
    nop
    nop

# func_InitSound
# Speaker modes above 7 take the silent stereo path like the others. The 3D
# buffers are resized from XACT's final mix mask, so the mode no longer matters
0x004D8E17:
    .byte   0x77, 0x0E  # ja short 0x004D8E27
