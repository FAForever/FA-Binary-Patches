# Moho::CBuildTaskHelper::UpdateWorkProgress
# Fix repairing an entity regenerating its shield while the shield is off.
#
# ShieldIsOn was only checked when the focus unit was at full health, so repairing
# a damaged unit regenerated its shield even while the shield was off.
#
# Always check ShieldIsOn; when it is off, return true for an undamaged unit as
# before, and skip the shield regen block for a damaged one.
#
# The focus unit WeakPtr null check is dropped to make room: the unit was
# already checked by dereference at 0x005F5F5E

CScriptObject__RunScript_Bool = 0x005F48A0
aShieldIsOn = 0x00E1F7BC # "ShieldIsOn"

RET_TRUE = 0x005F5C4D
SKIP_SHIELD_REGEN = 0x005F60D4

0x005F5FEF:
    mov     ecx, [esi]          # if( focusUnit->CScriptObject::RunScript_Bool("ShieldIsOn") )
    add     ecx, 4
    push    aShieldIsOn
    call    CScriptObject__RunScript_Bool
    test    al, al
    jnz     1f                  # shield on: regen block at 0x005F6015. Local label for smaller instruction size.
    test    bl, bl              # shield off: test focusUnitDamaged (loaded at 0x005F5FEB)
    jz      RET_TRUE            # undamaged
    jmp     SKIP_SHIELD_REGEN   # damaged
    nop
    nop
    nop
    nop
    nop
    nop
1:
